# Docker local demo uses compose.yaml and needs no secrets.
# Production configuration: set these in the hosting platform's environment.
ASPNETCORE_ENVIRONMENT=Production
Demo__Enabled=false
PublicBaseUrl=https://wardrobe.example.com
ConnectionStrings__Wardrobe=Data Source=/data/wardrobe.db
DataProtection__Path=/data/keys
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__From=wardrobe@example.com
Smtp__User=replace-in-secret-store
Smtp__Password=replace-in-secret-store
Authentication__Google__ClientId=replace-in-secret-store
Authentication__Google__ClientSecret=replace-in-secret-store
Authentication__Facebook__ClientId=replace-in-secret-store
Authentication__Facebook__ClientSecret=replace-in-secret-store
# Set only the real ingress proxy IP; never trust arbitrary forwarded headers.
# ReverseProxy__KnownProxies__0=10.0.0.10
